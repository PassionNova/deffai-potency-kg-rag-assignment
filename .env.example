# Copy to .env (git-ignored). Never commit real credentials.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Application role (non-owner, subject to row-level security)
DATABASE_URL=postgresql://potency_app:potency_app_dev@localhost:55433/potency
# Owner role, used only for migrations
OWNER_DATABASE_URL=postgresql://potency_owner:potency_owner_dev@localhost:55433/potency

# fastembed | fake   (fake = deterministic offline test double)
POTENCY_EMBEDDER=fastembed
# anthropic | fake   (fake = deterministic offline test double)
POTENCY_LLM=anthropic
POTENCY_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
FASTEMBED_CACHE_PATH=.cache/fastembed

# Hard stop for estimated model spend recorded in the global spend ledger (USD)
POTENCY_MAX_USD=40
# Pricing assumptions used for usage/cost estimates (USD per million tokens; claude-sonnet-5-5 list price 2026-10-07)
POTENCY_PRICE_INPUT_PER_MTOK=2.0
POTENCY_PRICE_OUTPUT_PER_MTOK=10.0
POTENCY_EXTRACTION_CONCURRENCY=4

# API dev tokens: token=tenant/project pairs separated by commas
POTENCY_DEV_TOKENS=dev-public=public-fda/casgevy-potency
